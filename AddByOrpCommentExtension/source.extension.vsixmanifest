<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="AddByOrpCommentExtension.ouriping.1234abcd" Version="1.0.0" Language="en-US" Publisher="ouriping" />
    <DisplayName>Add By Orp Comment Extension</DisplayName>
    <Description>Provides real-time comment completion with current date and time. Type 'addbyorp' to get '// add by orp YYYY.MM.DD HH:mm:ss'</Description>
    <MoreInfo>https://github.com/ouriping/VisualStudio</MoreInfo>
    <License>LICENSE.txt</License>
    <ReleaseNotes>Initial release for VS2022 17.14+</ReleaseNotes>
    <Tags>comment, completion, productivity</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Version="[17.0,18.0)" Id="Microsoft.VisualStudio.Community" />
    <InstallationTarget Version="[17.0,18.0)" Id="Microsoft.VisualStudio.Pro" />
    <InstallationTarget Version="[17.0,18.0)" Id="Microsoft.VisualStudio.Enterprise" />
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName="Microsoft .NET Framework" d:Source="Manual" Version="[4.7.2,)" />
  </Dependencies>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.MefComponent" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
  </Assets>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0,18.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
</PackageManifest>
